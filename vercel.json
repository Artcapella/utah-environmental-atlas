{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/map.html"
    },
    {
      "source": "/map",
      "destination": "/map.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/inversion",
      "destination": "/inversion.html"
    },
    {
      "source": "/promoters",
      "destination": "/promoters.html"
    },
    {
      "source": "/briefing",
      "destination": "/atlas/briefing.html"
    },
    {
      "source": "/screen",
      "destination": "/atlas/water-screen.html"
    }
  ],
  "redirects": [
    {
      "source": "/map/simple",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "17 10 * * *"
    },
    {
      "path": "/api/cron/ingest-live",
      "schedule": "32 10 * * *"
    },
    {
      "path": "/api/cron/refresh-guide",
      "schedule": "52 10 * * *"
    },
    {
      "path": "/api/cron/ingest-places",
      "schedule": "43 10 * * 1"
    }
  ]
}
